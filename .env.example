# Backend (backend/internal/config/config.go). Every value has a dev default.
PORT=8081
DB_PATH=optimolms.db

# Required in any real deployment: encrypts provider API keys and TOTP secrets
# at rest (AES-256-GCM). The backend falls back to an insecure dev value when it
# is unset — see docs/STATUS.md item 2.
AI_ENCRYPTION_SECRET=
